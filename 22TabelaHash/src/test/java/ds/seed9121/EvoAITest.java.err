package ds.seed9121;

import ds.TabelaHash;
import org.junit.Test;
import org.junit.experimental.categories.Category;

import java.io.ByteArrayOutputStream;
import java.io.PrintStream;

import static org.junit.Assert.*;
import org.evosuite.runtime.EvoRunner;
import org.evosuite.runtime.EvoRunnerParameters;
import org.junit.runner.RunWith;

/**
 * Unit tests for TabelaHash focusing on single-responsibility tests with clear assertions.
 * Requirement traceability:
 *  - REQ-DS-001: Basic insert/remove semantics
 *  - REQ-DS-002: Overwrite behavior on duplicate keys
 *  - REQ-DS-003: Print output contains stored keys
 *
 * NOTE: This class replaces the automatically generated scaffolding with focused, maintainable tests.
 */
interface UnitTest {}

@Category(UnitTest.class)
public class EvoAITest {

  @Test(timeout = 4000)
  public void test0()  throws Throwable  {
    // Given: a fresh hash table with one entry
    TabelaHash tabelaHash0 = new TabelaHash();
    final String key = "kb|j)i";
    final String value = "kb|j)i";
    tabelaHash0.insere(key, value);

    // When: printing the table contents
    ByteArrayOutputStream baos = new ByteArrayOutputStream();
    PrintStream ps = new PrintStream(baos, true);
    PrintStream originalOut = System.out;
    try {
      System.setOut(ps);
      tabelaHash0.imprime(); // Act: single behavior under test
    } finally {
      System.out.flush();
      System.setOut(originalOut);
    }

    // Then: the printed output should contain the inserted key (sanity check for imprime)
    String output;
    try {
      output = new String(baos.toByteArray(), "UTF-8");
    } catch (java.io.UnsupportedEncodingException e) {
      output = new String(baos.toByteArray());
    }
    assertNotNull("imprime() produced no output", output);
    assertTrue("Printed output should contain the inserted key", output.contains(key));
  }

  @Test(timeout = 4000)
  public void test1()  throws Throwable  {
    // Given: a table with a single key inserted
    TabelaHash tabelaHash0 = new TabelaHash();
    tabelaHash0.insere("K", "K");

    // When: removing that key (single Act)
    Object removed = tabelaHash0.retira("K");

    // Then: the removed value should match the original value
    assertEquals("retira should return the previously inserted value for key 'K'", "K", removed);
  }

  @Test(timeout = 4000)
  public void test2()  throws Throwable  {
    // Given: a table with a key initially mapped to a String
    TabelaHash tabelaHash0 = new TabelaHash();
    tabelaHash0.insere("kb|j)i", "kb|j)i");
    Object object0 = new Object();

    // When: inserting a new object under the same key (Act: overwrite)
    tabelaHash0.insere("kb|j)i", object0);

    // Then: removing the key should return the most recently inserted object (overwrite confirmation)
    Object removed = tabelaHash0.retira("kb|j)i");
    assertSame("retira should return the last inserted object for the key", object0, removed);
  }

  @Test(timeout = 4000)
  public void test3()  throws Throwable  {
    // Given: a table with two entries (one with empty string key, one with '[' key)
    TabelaHash tabelaHash0 = new TabelaHash();
    tabelaHash0.insere("", (Object) null);
    tabelaHash0.insere("[", (Object) null);

    // When: removing the entry for '[' (single Act)
    Object removed = tabelaHash0.retira("[");

    // Then: since the value inserted was null, retira should return null (and not throw)
    assertNull("Removing a key that was explicitly set to null should return null", removed);
  }

  @Test(timeout = 4000)
  public void test4()  throws Throwable  {
    // Given: a table with only the empty-string key present
    TabelaHash tabelaHash0 = new TabelaHash();
    tabelaHash0.insere("", (Object) null);

    // When: attempting to remove a non-existent key '[' (single Act)
    Object removed = tabelaHash0.retira("[");

    // Then: removing a non-existent key should return null and not affect the existing empty-string entry
    assertNull("Removing a non-existent key should return null", removed);

    // Additional sanity: the originally inserted empty key should still be removable and return null value
    Object removedEmpty = tabelaHash0.retira("");
    assertNull("The empty-string key was inserted with null and should return null when removed", removedEmpty);
  }
}