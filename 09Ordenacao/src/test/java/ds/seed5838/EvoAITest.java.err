package ds.seed5838;

import ds.Ordenacao;
import org.junit.Test;

import java.util.Arrays;

import static org.junit.Assert.*;
import static org.evosuite.runtime.EvoAssertions.*;
import org.evosuite.runtime.EvoRunner;
import org.evosuite.runtime.EvoRunnerParameters;
import org.junit.runner.RunWith;

/**
 * Tests for Ordenacao.mergeSort and related behaviors.
 *
 * <p>Requirement: REQ-Ordenacao-1 - The Ordenacao.mergeSort method must correctly sort integer arrays,
 * handle empty and single-element arrays, and fail fast when provided with invalid indices.</p>
 *
 * Note: Tests follow a Given-When-Then style in comments and include assertions that check outcomes
 * and side-effects to provide more meaningful diagnostics.
 */
public class EvoAITest {

    @Test(timeout = 4000)
    public void test0() throws Throwable {
        // Given: an array of length 4 with a known initial state
        int[] input = new int[4];
        input[0] = 352;
        int[] before = Arrays.copyOf(input, input.length);

        // When/Then: calling mergeSort with an out-of-range high index should throw ArrayIndexOutOfBoundsException
        try {
            Ordenacao.mergeSort(input, 0, 303);
            fail("Expected ArrayIndexOutOfBoundsException when high index is greater than array bounds");
        } catch (ArrayIndexOutOfBoundsException ex) {
            // Then: exception is thrown and array contents for valid indices remain unchanged
            assertNotNull("Exception message should not be null", ex.getMessage());
            // The implementation may include numeric index in message; ensure it at least contains digits or is informative
            assertTrue("Exception message should contain a digit or index information: " + ex.getMessage(),
                    ex.getMessage().matches(".*\\d.*"));
            assertArrayEquals("Array contents for valid indices should not be modified when an out-of-bounds call occurs",
                    before, input);
        }
    }

    @Test(timeout = 4000)
    public void test1() throws Throwable {
        // Given: an unsorted array
        int[] input = new int[]{5, 1, 4, 2, 3};
        int[] expected = new int[]{1, 2, 3, 4, 5};

        // When: mergeSort is invoked for the full array range
        Ordenacao.mergeSort(input, 0, input.length - 1);

        // Then: the array is sorted in ascending order and length is preserved
        assertEquals("Sorted array should have the same length as input", expected.length, input.length);
        assertArrayEquals("mergeSort should sort the array in ascending order", expected, input);
    }

    @Test(timeout = 4000)
    public void test2() throws Throwable {
        // Given: an Ordenacao instance and several boundary/edge-case arrays
        Ordenacao ordenacao = new Ordenacao();
        assertNotNull("Ordenacao instance should be creatable", ordenacao);

        // Empty array: Given an empty array
        int[] empty = new int[0];
        // When/Then: sorting an empty array should be a no-op and not throw
        try {
            Ordenacao.mergeSort(empty, 0, empty.length - 1); // typically (0, -1)
            assertEquals("Empty array should remain empty after mergeSort", 0, empty.length);
        } catch (Exception ex) {
            fail("mergeSort should handle empty arrays without throwing, but threw: " + ex);
        }

        // Single-element array: Given
        int[] single = new int[]{42};
        int[] singleBefore = Arrays.copyOf(single, single.length);
        // When/Then: sorting a single-element array should not change it
        Ordenacao.mergeSort(single, 0, 0);
        assertArrayEquals("Single-element array should remain unchanged after mergeSort", singleBefore, single);

        // Mixed values including negatives: Given
        int[] mixed = new int[]{0, -1, 5, -3, 2};
        int[] expectedMixed = new int[]{-3, -1, 0, 2, 5};
        // When: sort the mixed array
        Ordenacao.mergeSort(mixed, 0, mixed.length - 1);
        // Then: resulting array is sorted and contains the same multiset of elements
        assertArrayEquals("mergeSort should correctly sort arrays containing negative numbers", expectedMixed, mixed);
    }
}