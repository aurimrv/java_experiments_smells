package ds.seed1448;

import ds.ArvoreBinaria;
import ds.Item;
import ds.MeuItem;
import org.junit.Test;
import org.junit.experimental.categories.Category;

import static org.junit.Assert.*;
import static org.evosuite.runtime.EvoAssertions.*;
import org.evosuite.runtime.EvoRunner;
import org.evosuite.runtime.EvoRunnerParameters;
import org.evosuite.runtime.System;
import org.junit.runner.RunWith;

/**
 * Unit tests for ArvoreBinaria and MeuItem.
 *
 * Requirement trace: REQ-123 - Binary tree basic operations (insert/search/remove/modify keys).
 *
 * These tests were refactored from autogenerated cases to follow Arrange-Act-Assert,
 * include descriptive assertions and category tagging for selective execution.
 */
interface UnitTest {}

@Category(UnitTest.class)
public class EvoAITest {

    /* Helper factory to create MeuItem instances (remove magic numbers duplication). */
    private MeuItem item(int chave) {
        return new MeuItem(chave);
    }

    /* Helper to assert that a given item is present in the tree (search returns same instance). */
    private void assertPresent(ArvoreBinaria arv, MeuItem expected) {
        Item found = arv.pesquisa(expected);
        assertSame("Expected item with key " + expected.chave() + " to be present and returned by pesquisa()", expected, found);
    }

    /* Helper to assert that a given item is absent in the tree (search returns null). */
    private void assertAbsent(ArvoreBinaria arv, MeuItem probe) {
        Item found = arv.pesquisa(probe);
        assertNull("Expected item with key " + probe.chave() + " to be absent (pesquisa() == null)", found);
    }

    @Test(timeout = 4000)
    public void test00() throws Throwable {
        // Given: a binary tree with two items
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem meuItem0 = item(4);
        MeuItem meuItem1 = item(30);
        arvoreBinaria0.insere(meuItem0);
        arvoreBinaria0.insere(meuItem1);

        // When: modify the key of the second item (in-place)
        meuItem1.alteraChave(Integer.valueOf(0));

        // Then: the modified item should still be findable by searching the same instance,
        // and the first item should remain present.
        assertPresent(arvoreBinaria0, meuItem1);
        assertPresent(arvoreBinaria0, meuItem0);
        // Verify internal invariant on MeuItem size (token property used in legacy tests)
        assertEquals("MeuItem.tamanho() should remain 4 for modified item", 4, meuItem1.tamanho());
    }

    @Test(timeout = 4000)
    public void test01() throws Throwable {
        // Given: tree with two items
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem primeiro = item(17);
        MeuItem segundo = item(1);
        arvoreBinaria0.insere(primeiro);
        arvoreBinaria0.insere(segundo);

        // When: swap their keys (modify in-place)
        segundo.alteraChave(Integer.valueOf(17));
        primeiro.alteraChave(Integer.valueOf(1));

        // Then: both instances should still be present; searching for the same instances returns them.
        assertPresent(arvoreBinaria0, segundo);
        assertPresent(arvoreBinaria0, primeiro);
        // And sizes remain consistent
        assertEquals("primeiro.tamanho() should equal expected token 4", 4, primeiro.tamanho());
        assertEquals("segundo.tamanho() should equal expected token 4", 4, segundo.tamanho());
    }

    @Test(timeout = 4000)
    public void test02() throws Throwable {
        // Given: a tree where we insert a small positive and a large negative key
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem a = item(4);
        MeuItem b = item(-3272);
        arvoreBinaria0.insere(a);
        arvoreBinaria0.insere(b);

        // When/Then: both inserted instances can be found and have expected internal size
        assertPresent(arvoreBinaria0, a);
        assertPresent(arvoreBinaria0, b);
        assertEquals("MeuItem.tamanho() unexpected for item a", 4, a.tamanho());
        assertEquals("MeuItem.tamanho() unexpected for item b", 4, b.tamanho());
    }

    @Test(timeout = 4000)
    public void test03() throws Throwable {
        // Given: a tree with two items inserted in an order where the negative key is inserted first
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem positive = item(508);
        MeuItem negative = item(-1887);
        arvoreBinaria0.insere(negative);
        arvoreBinaria0.insere(positive);

        // When: remove the negative item
        arvoreBinaria0.retira(negative);

        // Then: negative item should no longer be found; positive item should still be present.
        assertAbsent(arvoreBinaria0, negative);
        assertPresent(arvoreBinaria0, positive);
        assertEquals("Removed item's tamanho() should remain 4", 4, negative.tamanho());
    }

    @Test(timeout = 4000)
    public void test04() throws Throwable {
        // Given: a tree with a single item
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem single = item(508);
        arvoreBinaria0.insere(single);

        // When: remove that item
        arvoreBinaria0.retira(single);

        // Then: it should no longer be searchable and its tamanho stays consistent
        assertAbsent(arvoreBinaria0, single);
        assertEquals("MeuItem.tamanho() should be unchanged after removal", 4, single.tamanho());
    }

    @Test(timeout = 4000)
    public void test05() throws Throwable {
        // Given: tree contains one item
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem present = item(4);
        MeuItem absent = item(30);
        arvoreBinaria0.insere(present);

        // When: attempt to remove an item that was never inserted
        arvoreBinaria0.retira(absent);

        // Then: the original item is still present; the absent item is not found and its tamanho is stable
        assertPresent(arvoreBinaria0, present);
        assertAbsent(arvoreBinaria0, absent);
        assertEquals("Absent item's tamanho() should be 4", 4, absent.tamanho());
    }

    @Test(timeout = 4000)
    public void test06() throws Throwable {
        // Given: tree with one positive item
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem present = item(508);
        MeuItem notPresent = item(-1887);
        arvoreBinaria0.insere(present);

        // When: attempt to remove non-existing item
        arvoreBinaria0.retira(notPresent);

        // Then: present remains findable; non-present still not found; size invariant holds
        assertPresent(arvoreBinaria0, present);
        assertAbsent(arvoreBinaria0, notPresent);
        assertEquals("Non-present item's tamanho() should be 4", 4, notPresent.tamanho());
    }

    @Test(timeout = 4000)
    public void test07() throws Throwable {
        // Given: multiple items inserted into the tree
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem root = item(4);
        MeuItem left = item(-3272);
        MeuItem right = item(34);
        MeuItem extra = item(-401);
        arvoreBinaria0.insere(root);
        arvoreBinaria0.insere(left);
        arvoreBinaria0.insere(right);
        arvoreBinaria0.insere(extra);

        // When: remove the root item
        arvoreBinaria0.retira(root);

        // Then: the removed item should not be found; other inserted items remain findable and distinct
        assertAbsent(arvoreBinaria0, root);
        assertPresent(arvoreBinaria0, left);
        assertPresent(arvoreBinaria0, right);
        assertPresent(arvoreBinaria0, extra);
        assertNotSame("Different inserted instances should not be the same reference", root, extra);
    }

    @Test(timeout = 4000)
    public void test08() throws Throwable {
        // Given: tree with two items
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem a = item(4);
        MeuItem b = item(34);
        arvoreBinaria0.insere(a);
        arvoreBinaria0.insere(b);

        // Then: both items are present (no call to System.exit or other global actions)
        assertPresent(arvoreBinaria0, a);
        assertPresent(arvoreBinaria0, b);
    }

    @Test(timeout = 4000)
    public void test09() throws Throwable {
        // Given: same instance inserted twice
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem single = item(4);
        arvoreBinaria0.insere(single);

        // When: attempt to insert the same instance again
        arvoreBinaria0.insere(single);

        // Then: searching returns the same instance and tamanho remains unchanged
        assertPresent(arvoreBinaria0, single);
        assertEquals("Repeated insertion should not change MeuItem.tamanho()", 4, single.tamanho());
    }

    @Test(timeout = 4000)
    public void test10() throws Throwable {
        // Given: tree containing one item
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem present = item(4);
        arvoreBinaria0.insere(present);

        // When: searching for an unrelated key
        MeuItem probe = item(34);

        // Then: search returns null
        Item item0 = arvoreBinaria0.pesquisa(probe);
        assertNull("pesquisa() should return null for a non-inserted key", item0);
    }

    @Test(timeout = 4000)
    public void test11() throws Throwable {
        // Given: tree with one small positive key
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem present = item(4);
        arvoreBinaria0.insere(present);

        // When: search for zero key which was not inserted
        MeuItem probe = item(0);

        // Then: search should return null
        Item item0 = arvoreBinaria0.pesquisa(probe);
        assertNull("Expected pesquisa() to return null for key 0 when not present", item0);
    }

    @Test(timeout = 4000)
    public void test12() throws Throwable {
        // Given: a single negative key inserted into the tree
        ArvoreBinaria arvoreBinaria0 = new ArvoreBinaria();
        MeuItem inserted = item(-340);
        arvoreBinaria0.insere(inserted);

        // When/Then: searching for the exact instance returns the same instance
        Item item0 = arvoreBinaria0.pesquisa(inserted);
        assertSame("pesquisa() should return the exact same instance that was inserted", item0, inserted);
    }
}